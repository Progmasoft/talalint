packages: talalint.cabal

-- The compiler packages come from Hackage. Only tala-tooling is used
-- directly; the others are its dependencies.

with-compiler: ghc
tests: True
documentation: False
write-ghc-environment-files: never

-- Warnings are errors for this package only; its dependencies build with
-- their own settings.
package talalint
    ghc-options:
        -Wall
        -Wextra
        -Werror
        -Wcompat
        -Widentities
        -Wincomplete-patterns
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wincomplete-record-selectors
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wredundant-constraints
        -Wmissing-signatures
        -Wmissing-methods
        -Wmissing-fields
        -Wtype-defaults
        -Woverflowed-literals
        -Wempty-enumerations
        -Woverlapping-patterns
        -Wnoncanonical-monad-instances
        -Wnoncanonical-monoid-instances
        -Wredundant-bang-patterns
        -Wunbanged-strict-patterns
        -Wunused-imports
        -Wunused-local-binds
        -Wunused-top-binds
        -Wname-shadowing
